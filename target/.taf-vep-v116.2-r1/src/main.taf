<taf-app:container:ghcr.io/taffish/vep:116.2-r1$@[docker: $(printf -- '--user=%s:%s' "$(id -u)" "$(id -g)") $(taf_vep_install="${TAFFISH_VEP_DATA_INSTALL_ROOT:-}"; if test -n "$taf_vep_install"; then if test -d "$taf_vep_install"; then taf_vep_install="$(cd "$taf_vep_install" 2>/dev/null && pwd -P)"; printf -- '--volume=%s:/data-install --env=TAFFISH_VEP_DATA_INSTALL_MOUNTED=1' "$taf_vep_install"; else printf >&2 'taf-vep: TAFFISH_VEP_DATA_INSTALL_ROOT does not exist or is not a directory: %s\n' "$taf_vep_install"; fi; fi)][podman: $(printf -- '--userns=keep-id --user=%s:%s' "$(id -u)" "$(id -g)") $(taf_vep_install="${TAFFISH_VEP_DATA_INSTALL_ROOT:-}"; if test -n "$taf_vep_install"; then if test -d "$taf_vep_install"; then taf_vep_install="$(cd "$taf_vep_install" 2>/dev/null && pwd -P)"; printf -- '--volume=%s:/data-install --env=TAFFISH_VEP_DATA_INSTALL_MOUNTED=1' "$taf_vep_install"; else printf >&2 'taf-vep: TAFFISH_VEP_DATA_INSTALL_ROOT does not exist or is not a directory: %s\n' "$taf_vep_install"; fi; fi)][apptainer: $(taf_vep_install="${TAFFISH_VEP_DATA_INSTALL_ROOT:-}"; if test -n "$taf_vep_install"; then if test -d "$taf_vep_install"; then taf_vep_install="$(cd "$taf_vep_install" 2>/dev/null && pwd -P)"; printf -- '--bind=%s:/data-install --env=TAFFISH_VEP_DATA_INSTALL_MOUNTED=1' "$taf_vep_install"; else printf >&2 'taf-vep: TAFFISH_VEP_DATA_INSTALL_ROOT does not exist or is not a directory: %s\n' "$taf_vep_install"; fi; fi)][docker/podman: $(taf_vep_complete() { test -f "$1/TAFFISH_VEP_DATA_MANIFEST.json" && test -f "$1/TAFFISH_VEP_DATA_INVENTORY.tsv" && test -f "$1/TAFFISH_VEP_DATA_READY" && grep -F 'taffish.vep.dataset.v1' "$1/TAFFISH_VEP_DATA_MANIFEST.json" >/dev/null && grep -F '"cache_version" : "116"' "$1/TAFFISH_VEP_DATA_MANIFEST.json" >/dev/null; }; if test -n "${TAFFISH_VEP_DATA_INSTALL_ROOT:-}"; then exit 0; fi; taf_vep_auto="${TAFFISH_VEP_AUTO_MOUNT:-1}"; if test "$taf_vep_auto" = 0 || test "$taf_vep_auto" = false || test "$taf_vep_auto" = FALSE || test "$taf_vep_auto" = no || test "$taf_vep_auto" = NO || test "$taf_vep_auto" = off || test "$taf_vep_auto" = OFF; then exit 0; fi; taf_vep_data="${TAFFISH_VEP_DATA_PATH:-}"; taf_vep_dataset="${TAFFISH_VEP_DATASET:-}"; taf_vep_explicit=0; if test -n "$taf_vep_data"; then taf_vep_explicit=1; elif test -n "$taf_vep_dataset"; then taf_vep_explicit=1; taf_vep_bad="$(printf '%s' "$taf_vep_dataset" | tr -d 'A-Za-z0-9_.+-')"; if test -n "$taf_vep_bad"; then printf >&2 'taf-vep: unsafe TAFFISH_VEP_DATASET: %s\n' "$taf_vep_dataset"; printf -- '--taffish-vep-invalid-resource-selector'; exit 0; fi; for taf_vep_candidate in "${HOME:-}/.local/share/taffish/databases/vep/release-116/$taf_vep_dataset" "/usr/local/share/taffish/databases/vep/release-116/$taf_vep_dataset" "/opt/taffish/databases/vep/release-116/$taf_vep_dataset"; do if taf_vep_complete "$taf_vep_candidate" && grep -F '"dataset_id" : "'"$taf_vep_dataset"'"' "$taf_vep_candidate/TAFFISH_VEP_DATA_MANIFEST.json" >/dev/null; then taf_vep_data="$taf_vep_candidate"; break; fi; done; fi; if test -n "$taf_vep_data" && taf_vep_complete "$taf_vep_data"; then taf_vep_data="$(cd "$taf_vep_data" 2>/dev/null && pwd -P)"; printf -- '--volume=%s:/opt/taffish/vep-cache:ro' "$taf_vep_data"; elif test "$taf_vep_explicit" = 1; then printf >&2 'taf-vep: selected VEP data root is missing or incomplete: %s%s\n' "$taf_vep_data" "$taf_vep_dataset"; printf -- '--taffish-vep-invalid-resource-root'; fi)][apptainer: $(taf_vep_complete() { test -f "$1/TAFFISH_VEP_DATA_MANIFEST.json" && test -f "$1/TAFFISH_VEP_DATA_INVENTORY.tsv" && test -f "$1/TAFFISH_VEP_DATA_READY" && grep -F 'taffish.vep.dataset.v1' "$1/TAFFISH_VEP_DATA_MANIFEST.json" >/dev/null && grep -F '"cache_version" : "116"' "$1/TAFFISH_VEP_DATA_MANIFEST.json" >/dev/null; }; if test -n "${TAFFISH_VEP_DATA_INSTALL_ROOT:-}"; then exit 0; fi; taf_vep_auto="${TAFFISH_VEP_AUTO_MOUNT:-1}"; if test "$taf_vep_auto" = 0 || test "$taf_vep_auto" = false || test "$taf_vep_auto" = FALSE || test "$taf_vep_auto" = no || test "$taf_vep_auto" = NO || test "$taf_vep_auto" = off || test "$taf_vep_auto" = OFF; then exit 0; fi; taf_vep_data="${TAFFISH_VEP_DATA_PATH:-}"; taf_vep_dataset="${TAFFISH_VEP_DATASET:-}"; taf_vep_explicit=0; if test -n "$taf_vep_data"; then taf_vep_explicit=1; elif test -n "$taf_vep_dataset"; then taf_vep_explicit=1; taf_vep_bad="$(printf '%s' "$taf_vep_dataset" | tr -d 'A-Za-z0-9_.+-')"; if test -n "$taf_vep_bad"; then printf >&2 'taf-vep: unsafe TAFFISH_VEP_DATASET: %s\n' "$taf_vep_dataset"; printf -- '--taffish-vep-invalid-resource-selector'; exit 0; fi; for taf_vep_candidate in "${HOME:-}/.local/share/taffish/databases/vep/release-116/$taf_vep_dataset" "/usr/local/share/taffish/databases/vep/release-116/$taf_vep_dataset" "/opt/taffish/databases/vep/release-116/$taf_vep_dataset"; do if taf_vep_complete "$taf_vep_candidate" && grep -F '"dataset_id" : "'"$taf_vep_dataset"'"' "$taf_vep_candidate/TAFFISH_VEP_DATA_MANIFEST.json" >/dev/null; then taf_vep_data="$taf_vep_candidate"; break; fi; done; fi; if test -n "$taf_vep_data" && taf_vep_complete "$taf_vep_data"; then taf_vep_data="$(cd "$taf_vep_data" 2>/dev/null && pwd -P)"; printf -- '--bind=%s:/opt/taffish/vep-cache:ro' "$taf_vep_data"; elif test "$taf_vep_explicit" = 1; then printf >&2 'taf-vep: selected VEP data root is missing or incomplete: %s%s\n' "$taf_vep_data" "$taf_vep_dataset"; printf -- '--taffish-vep-invalid-resource-root'; fi)]>
vep ::*ARGV*::
