td:first-child{{font-weight:550;width:42%}}tr:last-child td{{border-bottom:0}}code{{overflow-wrap:anywhere;font-size:.84rem}}footer{{margin-top:24px;color:#506774}}
@media(max-width:620px){{main{{padding:24px 14px 44px}}section{{padding:18px 14px}}.bar-row{{grid-template-columns:minmax(0,1fr) auto;gap:5px 12px}}.bar-label{{grid-column:1}}.value{{grid-column:2;grid-row:1}}.track{{grid-column:1/-1;grid-row:2}}td{{padding:8px}}}}
@media print{{body{{background:white}}main{{max-width:none;padding:0}}nav,.download{{display:none}}section{{border-radius:0}}h2,summary{{break-after:avoid}}tr,.bar-row{{break-inside:avoid}}.table-scroll{{overflow:visible}}}}
</style></head><body><main><header><div class="eyebrow">TAFFISH · VEP · OFFLINE STATISTICS VIEWER</div>
<h1>{escape(title)}</h1><p>This independent viewer displays the original text statistics produced by Ensembl VEP.
It does not annotate variants, infer biological conclusions, or reproduce Google Charts. The original upstream HTML is unchanged.</p>
<p class="muted">{len(sections)} sections · {sum(len(rows) for _, rows in sections)} original rows · No network required</p>
