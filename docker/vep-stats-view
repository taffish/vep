Reports may contain sample names, paths and command arguments. Share according to your data policy.</footer></main></body></html>'''


def main():
    parser = argparse.ArgumentParser(description='Render VEP --stats_text output as an independent standalone offline HTML viewer.')
    parser.add_argument('--input', required=True, type=Path)
    parser.add_argument('--output', required=True, type=Path)
    parser.add_argument('--title', default='VEP run statistics')
    parser.add_argument('--force', action='store_true', help='Replace an existing regular output file atomically')
    args = parser.parse_args()
    try:
        if args.output.is_symlink() or args.input.resolve() == args.output.resolve():
            raise ValueError('Output must not be a symlink or the input file')
        if args.output.exists() and (not args.force or not args.output.is_file()):
            raise ValueError('Output exists; choose a new path or use --force for a regular file')
        content = render(args.input.read_bytes(), args.title, args.input.name)
        fd, temporary = tempfile.mkstemp(prefix='.vep-stats-', dir=args.output.parent)
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as stream:
                stream.write(content)
            if args.force:
                os.replace(temporary, args.output)
            else:
                os.link(temporary, args.output)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        print(f'Offline statistics viewer: {args.output}')
    except (OSError, UnicodeError, ValueError) as error:
        parser.exit(2, f'vep-stats-view: {error}\n')


if __name__ == '__main__':
    main()
