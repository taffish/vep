#!/usr/bin/python3
"""只展示上游 --stats_text 输出，不重新计算变异注释或改变原始统计行。"""
import argparse
import base64
from decimal import Decimal, InvalidOperation
import hashlib
from html import escape
import os
from pathlib import Path
import tempfile


def parse(raw):
    text = raw.decode('utf-8-sig')
    sections = []
    for line in text.splitlines():
        if not line.strip():
            continue
        if line.startswith('[') and line.endswith(']'):
            sections.append((line[1:-1], []))
        elif sections:
            sections[-1][1].append(line.split('\t'))
        else:
            raise ValueError('Expected VEP --stats_text section header')
    if not sections or sections[0][0] != 'VEP run statistics':
        raise ValueError('Not a VEP --stats_text statistics file')
    if not any(title == 'General statistics' for title, _ in sections):
        raise ValueError('Missing General statistics section')
    return sections


def numeric_rows(rows):
    values = []
    for row in rows:
        if len(row) != 2:
            return None
        try:
            value = Decimal(row[1])
        except InvalidOperation:
            return None
        if not value.is_finite() or value < 0:
            return None
        values.append(value)
    return values or None


def render(raw, title, source):
    sections = parse(raw)
    body, toc = [], []
    for index, (heading, rows) in enumerate(sections):
        ident = f'section-{index}'
        toc.append(f'<a href="#{ident}">{escape(heading)}</a>')
        body.append(f'<section id="{ident}"><h2>{escape(heading)}</h2>')
        values = numeric_rows(rows) if index > 2 else None
        if values is not None:
            maximum = max(values)
            body.append('<p class="muted">Original values, in upstream order. Bars share a zero baseline '
                        'within this section; scales differ between sections. No category is omitted.</p><div class="bars">')
            for row, value in zip(rows, values):
                width = float(value / maximum * 100) if maximum else 0
                body.append(f'<div class="bar-row"><span class="bar-label">{escape(row[0])}</span>'
                            f'<span class="track" aria-hidden="true"><span style="width:{width:.8f}%"></span></span>'
                            f'<span class="value">{escape(row[1])}</span></div>')
            body.append('</div>')
        body.append('<details open><summary>Original data rows</summary><div class="table-scroll">'
                    f'<table aria-label="{escape(heading, quote=True)}"><tbody>')
        for row in rows:
            body.append('<tr>' + ''.join(f'<td>{escape(cell)}</td>' for cell in row) + '</tr>')
        body.append('</tbody></table></div></details></section>')
    download = base64.b64encode(raw).decode('ascii')
    sha = hashlib.sha256(raw).hexdigest()
    return f'''<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<title>{escape(title)}</title><style>
:root{{color-scheme:light;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#183342;background:#f3f6f8}}
*{{box-sizing:border-box}}body{{margin:0;font-size:16px;line-height:1.55}}main{{max-width:1180px;margin:auto;padding:36px 24px 64px}}
h1{{font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.15;margin:12px 0 20px;overflow-wrap:anywhere}}
h2{{font-size:1.35rem;margin:0 0 16px;overflow-wrap:anywhere}}.eyebrow{{font-weight:700;letter-spacing:.1em;font-size:.8rem;color:#246572}}
.muted{{color:#506774}}header p{{max-width:88ch}}a{{color:#006879;text-underline-offset:.2em;overflow-wrap:anywhere}}
.download{{display:inline-block;border:1px solid #508492;border-radius:8px;padding:10px 16px;background:white;margin:6px 0 12px}}
a:focus-visible,summary:focus-visible{{outline:3px solid #d58a11;outline-offset:4px}}
nav{{display:flex;flex-wrap:wrap;gap:8px 18px;border-top:1px solid #cbd9df;padding:18px 0;margin-top:16px}}
section{{background:white;border:1px solid #d3e0e6;border-radius:12px;padding:26px;margin:20px 0;scroll-margin-top:16px}}
.bars{{display:grid;gap:12px;margin:22px 0 28px}}.bar-row{{display:grid;grid-template-columns:minmax(130px,30%) minmax(80px,1fr) minmax(70px,auto);align-items:center;gap:14px}}
.bar-label,.value{{overflow-wrap:anywhere}}.value{{text-align:right;font-variant-numeric:tabular-nums}}.track{{display:block;background:#edf3f5;border-radius:3px;min-height:20px}}
.track>span{{display:block;background:#167f92;border-radius:3px;min-height:20px}}summary{{cursor:pointer;font-weight:600;padding:8px 0}}
